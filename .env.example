# Copy this file to .env and fill in your key(s). Never commit the real .env.

# Required - used by LlamaIndex RAG/SQL synthesis, the LangGraph supervisor,
# CrewAI, and (by default) the ADK agents via LiteLLM.
OPENAI_API_KEY=sk-your-key-here

# Optional overrides
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional - ADK agent model. Default routes ADK agents through OpenAI via
# LiteLLM so only OPENAI_API_KEY is required. To use Gemini instead, set:
#   ADK_MODEL=gemini-2.0-flash
#   GOOGLE_API_KEY=your-google-key
ADK_MODEL=openai/gpt-4o-mini
GOOGLE_API_KEY=

# Optional - ADK A2A service ports / URLs (defaults shown)
NETWORK_DIAGNOSTICS_PORT=8001
BILLING_RESOLUTION_PORT=8002
NETWORK_DIAGNOSTICS_AGENT_URL=http://localhost:8001
BILLING_RESOLUTION_AGENT_URL=http://localhost:8002
